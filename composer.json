{
    "name": "davox/realfavicon-plugin",
    "type": "october-plugin",
    "description": "An October CMS plugin that generates a complete, multi-platform favicon set using the RealFaviconGenerator.net service.",
    "homepage": "https://github.com/Davox08/oc-realfavicon-plugin",
    "keywords": [
        "octobercms",
        "favicon",
        "realfavicongenerator",
        "seo"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Hernandez",
            "role": "Developer",
            "email": "developer@dobermag.com"
        }
    ],
    "require": {
        "php": ">=8.0.2",
        "composer/installers": "^1.0 || ^2.0",
        "october/system": "^3.0|^4.0"
    },
    "minimum-stability": "dev",
    "extra": {
        "october": {
            "plugin": "Davox.RealFavicon"
        }
    }
}
